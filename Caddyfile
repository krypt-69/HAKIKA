:80 {
	@customer {
		path /customer
	}
	redir @customer /customer/ permanent

	@business {
		path /business
	}
	redir @business /business/ permanent

	@rider {
		path /rider
	}
	redir @rider /rider/ permanent

	@admin {
		path /admin
	}
	redir @admin /admin/ permanent

	@root {
		path /
	}
	redir @root /customer/ permanent

	handle /customer/* {
		reverse_proxy localhost:3002
	}

	handle /business/* {
		reverse_proxy localhost:3001
	}

	handle /rider/* {
		reverse_proxy localhost:3003
	}

	handle /admin/* {
		reverse_proxy localhost:3004
	}

	# WebSocket endpoints — explicit upgrade
	handle /api/v1/ws/* {
		reverse_proxy localhost:8000 {
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	handle /api/v1/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy localhost:8000
	}

	handle /uploads/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy localhost:8000
	}
}
